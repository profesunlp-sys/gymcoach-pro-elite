rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isCoordinator() {
      return isSignedIn() && request.auth.token.email == 'profesunlp@gmail.com';
    }
    
    function isStaff() {
      return isSignedIn() && (
        isCoordinator() ||
        request.auth.token.email == 'mi.xt1032@gmail.com'
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Alumnos (Atletas): read, create, update, delete only isStaff()
    match /alumnos/{alumnoId} {
      allow read, create, update, delete: if isStaff();
    }

    // Pagos Gimnasia: only Coordinator
    match /pagosGimnasia/{pagoId} {
      allow read, write: if isCoordinator();
    }

    // Asistencias: read and write only isStaff()
    match /asistencias/{asistenciaId} {
      allow read, write: if isStaff();
    }

    // Profesores Gimnasia: read if isCoordinator() or if doc is user's own email; write only isCoordinator()
    match /profesoresGimnasia/{profesorId} {
      allow read: if isCoordinator() || (isSignedIn() && request.auth.token.email == profesorId);
      allow write: if isCoordinator();
    }

    // Asignaciones Gimnasia: read isStaff(), write isCoordinator()
    match /asignacionesGimnasia/{asignacionId} {
      allow read: if isStaff();
      allow write: if isCoordinator();
    }
  }
}
